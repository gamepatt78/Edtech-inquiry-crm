{
  "name": "edtech-inquiry-crm",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -k -n API,WEB \"node backend/src/server.js\" \"node node_modules/vite/bin/vite.js frontend --host 0.0.0.0\"",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
