# PostgreSQL connection string from your Supabase project's connection settings.
# Use the Session pooler URI if your deployment platform cannot reach the direct database.
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require

# Generate a random secret of at least 32 characters.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Used only by the create-admin command; do not commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
